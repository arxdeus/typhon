# Expected values generated by test/torch/gen_nn_expected.py (torch 2.15.0).
import torch
import torch.nn as nn
import torch.nn.functional as F

def X(shape: List[int], seed: int, dtype = torch.float64) -> torch.Tensor:
    n = 1
    for s in shape: n *= s
    return ((torch.arange(n, dtype=torch.float64) * 0.37 + float(seed)).sin() * 2.0).reshape(shape).to(dtype)

def close(t: torch.Tensor, exp: List[float], rtol: float) -> bool:
    v = t.detach().contiguous().reshape([-1]).double().tolist()
    if len(v) != len(exp):
        print("len mismatch", len(v), len(exp))
        return False
    scale = 0.0
    for e in exp: scale = max(scale, abs(e))
    for i in range(len(v)):
        if abs(v[i] - exp[i]) > rtol * max(abs(exp[i]), 1e-3 * scale):
            print("mismatch at", i, v[i], exp[i])
            return False
    return True

def closef(a: float, b: float, rtol: float) -> bool:
    return abs(a - b) <= rtol * abs(b)
from torch.nn.utils import parametrize as P
from torch.nn.utils.parametrizations import weight_norm

class MaxNorm(nn.Module):
    m: float
    def __init__(self, m: float):
        super().__init__()
        self.m = m
    def forward(self, X: torch.Tensor) -> torch.Tensor:
        n = X.reshape([X.size(0), -1]).norm(2, 1, keepdim=True)
        d = n.clamp(self.m / 2, None)
        num = d.clamp(None, self.m)
        return X * (num / (d + 1e-5)).reshape([-1] + [1] * (X.dim() - 1))

@test
def test_init_parity():
    # bit-exact default init through torch's MT19937 stream
    torch.manual_seed(0)
    c = nn.Conv2d(2, 3, (1, 3))
    l = nn.Linear(4, 2)
    SHOW("conv_w", c.weight, 0.0)
    SHOW("conv_b", c.bias.__val__(), 0.0)
    SHOW("lin_w", l.weight, 0.0)
    SHOW("lin_b", l.bias.__val__(), 0.0)
    SHOW("after", torch.rand([3]), 0.0)
    w = torch.empty([3, 5])
    assert nn.init._calculate_fan_in_and_fan_out(torch.empty([4, 3, 2, 5])) == (30, 40)
    assert abs(nn.init.calculate_gain("leaky_relu", 0.2) - 1.3867504905630728) < 1e-15

@test
def test_parametrize():
    torch.manual_seed(0)
    lin = nn.Linear(5, 3)
    P.register_parametrization(lin, "weight", MaxNorm(0.5))
    EQ("ptz_keys", list(lin.state_dict().keys()))
    SHOW("ptz_w", lin.weight, 1e-6)
    lin(torch.ones([2, 5])).sum().backward()
    g = lin.get_submodule("parametrizations.weight")
    SHOW("ptz_grad", g.get_parameter("original").grad.__val__(), 1e-4)
    assert P.is_parametrized(lin, "weight")

@test
def test_weight_norm():
    torch.manual_seed(0)
    c = weight_norm(nn.Conv1d(2, 3, 2))
    EQ("wn_keys", list(c.state_dict().keys()))
    y = c(X([1, 2, 4], 14, torch.float32))
    y.sum().backward()
    SHOW("wn_y", y, 1e-5)
    SHOW("wn_g0", c.get_parameter("parametrizations.weight.original0").grad.__val__(), 1e-5)
    SHOW("wn_g1", c.get_parameter("parametrizations.weight.original1").grad.__val__(), 1e-5)

@test
def test_clip_grad_norm():
    torch.manual_seed(0)
    lin = nn.Linear(4, 3).double()
    ((lin(X([2, 4], 15)) ** 2).sum()).backward()
    tn = nn.utils.clip_grad_norm_(lin.parameters(), 0.5)
    NUM("clip_total", tn.item(), 1e-13)
    SHOW("clip_gw", lin.weight.grad.__val__(), 1e-12)

test_init_parity()
test_parametrize()
test_weight_norm()
test_clip_grad_norm()
