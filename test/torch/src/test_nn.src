# Expected values generated by test/torch/gen_nn_expected.py (torch 2.15.0).
import torch
import torch.nn as nn
import torch.nn.functional as F

def X(shape: List[int], seed: int, dtype = torch.float64) -> torch.Tensor:
    n = 1
    for s in shape: n *= s
    return ((torch.arange(n, dtype=torch.float64) * 0.37 + float(seed)).sin() * 2.0).reshape(shape).to(dtype)

def close(t: torch.Tensor, exp: List[float], rtol: float) -> bool:
    v = t.detach().contiguous().reshape([-1]).double().tolist()
    if len(v) != len(exp):
        print("len mismatch", len(v), len(exp))
        return False
    scale = 0.0
    for e in exp: scale = max(scale, abs(e))
    for i in range(len(v)):
        if abs(v[i] - exp[i]) > rtol * max(abs(exp[i]), 1e-3 * scale):
            print("mismatch at", i, v[i], exp[i])
            return False
    return True

def closef(a: float, b: float, rtol: float) -> bool:
    return abs(a - b) <= rtol * abs(b)

@test
def test_conv2d():
    x = X([2, 4, 5, 7], 1).requires_grad_()
    w = X([6, 2, 2, 3], 2).requires_grad_()
    b = X([6], 3).requires_grad_()
    y = F.conv2d(x, w, b, stride=(1, 2), padding=(1, 2), dilation=(2, 1), groups=2)
    EQ("conv_shape", list(y.shape))
    SHOW("conv_y", y, 1e-12)
    (y * y).sum().backward()
    SHOW("conv_gx", x.grad.__val__(), 1e-12)
    SHOW("conv_gw", w.grad.__val__(), 1e-12)
    SHOW("conv_gb", b.grad.__val__(), 1e-12)

@test
def test_conv1d_pad():
    x1 = X([2, 3, 9], 4)
    w1 = X([4, 3, 4], 5)
    SHOW("conv1d_same", F.conv1d(x1, w1, padding="same"), 1e-12)
    SHOW("pad_reflect", F.pad(x1, [2, 3], mode="reflect"), 1e-15)
    SHOW("pad_replicate", F.pad(x1, [1, 2], mode="replicate"), 1e-15)
    SHOW("pad_circular", F.pad(x1, [2, 1], mode="circular"), 1e-15)
    SHOW("pad_const", F.pad(x1, [1, 1, 0, 2], value=0.5), 1e-15)

@test
def test_pool():
    x1 = X([2, 3, 9], 4)
    xp = X([2, 3, 6, 9], 6).requires_grad_()
    mp = F.max_pool2d(xp, (2, 3), (2, 2), (1, 1), ceil_mode=True)
    ap = F.avg_pool2d(xp, (3, 2), (2, 3), (1, 1), count_include_pad=False)
    EQ("maxpool_shape", list(mp.shape))
    SHOW("maxpool", mp, 1e-15)
    EQ("avgpool_shape", list(ap.shape))
    SHOW("avgpool", ap, 1e-13)
    (mp.sum() + (ap * ap).sum()).backward()
    SHOW("pool_gx", xp.grad.__val__(), 1e-13)
    SHOW("adapt_avg", F.adaptive_avg_pool2d(xp.detach(), (4, 5)), 1e-12)
    SHOW("avgpool1d", F.avg_pool1d(x1, 3, 2), 1e-13)
    SHOW("maxpool1d", F.max_pool1d(x1, 2), 1e-15)

@test
def test_pool1d_shapes():
    z = torch.zeros([2, 128, 161])
    assert list(nn.MaxPool1d(2)(z).shape) == [2, 128, 80]
    assert list(nn.AvgPool1d(3, 2)(z).shape) == [2, 128, 80]
    assert list(F.max_pool1d(z[0], 2).shape) == [128, 80]
    assert list(F.avg_pool1d(z[0], 2).shape) == [128, 80]
    assert list(nn.AdaptiveAvgPool1d(7)(z).shape) == [2, 128, 7]

@test
def test_batchnorm():
    torch.manual_seed(0)
    bn = nn.BatchNorm2d(3, momentum=0.2).double()
    xb = X([4, 3, 2, 5], 7)
    SHOW("bn_train", bn(xb), 1e-13)
    SHOW("bn_rm", bn.running_mean.__val__(), 1e-13)
    SHOW("bn_rv", bn.running_var.__val__(), 1e-13)
    bn.eval()
    SHOW("bn_eval", bn(xb), 1e-13)
    EQ("bn_keys", list(bn.state_dict().keys()))

@test
def test_activations_norms():
    xa = X([3, 5], 8)
    SHOW("act_elu", F.elu(xa), 1e-13)
    SHOW("act_gelu", F.gelu(xa), 1e-13)
    SHOW("act_gelu_tanh", F.gelu(xa, approximate="tanh"), 1e-13)
    SHOW("act_silu", F.silu(xa), 1e-13)
    SHOW("act_lrelu", F.leaky_relu(xa), 1e-13)
    SHOW("act_hswish", F.hardswish(xa), 1e-13)
    SHOW("act_softmax", F.softmax(xa, 1), 1e-13)
    SHOW("act_logsoftmax", F.log_softmax(xa, 1), 1e-13)
    SHOW("act_softplus", F.softplus(xa), 1e-13)
    SHOW("layernorm", F.layer_norm(xa, [5]), 1e-13)
    SHOW("groupnorm", F.group_norm(X([2, 4, 3], 9), 2), 1e-13)

@test
def test_losses():
    xa = X([3, 5], 8)
    logits = X([4, 3], 10).requires_grad_()
    tgt = torch.tensor([0, 2, 1, 2])
    wt = torch.tensor([0.5, 1.0, 2.0], dtype=torch.float64)
    ce = F.cross_entropy(logits, tgt, weight=wt, label_smoothing=0.1)
    NUM("ce", ce.item(), 1e-13)
    ce.backward()
    SHOW("ce_grad", logits.grad.__val__(), 1e-13)
    NUM("ce_plain", F.cross_entropy(logits, tgt).item(), 1e-13)
    NUM("nll", F.nll_loss(F.log_softmax(logits, 1), tgt).item(), 1e-13)
    NUM("mse", F.mse_loss(xa, xa * 0.5).item(), 1e-13)
    NUM("bce_logits", F.binary_cross_entropy_with_logits(xa, (xa > 0.0).double()).item(), 1e-13)
    NUM("ce", nn.CrossEntropyLoss(weight=wt, label_smoothing=0.1)(logits, tgt).item(), 1e-13)

@test
def test_dropout():
    torch.manual_seed(3)
    SHOW("dropout", F.dropout(torch.ones([2, 8]), 0.3), 0.0)
    torch.manual_seed(3)
    SHOW("dropout2d", F.dropout2d(torch.ones([2, 3, 2, 2]), 0.5), 0.0)
    d = nn.Dropout(0.3)
    d.eval()
    assert d(torch.ones([4])).tolist() == [1.0, 1.0, 1.0, 1.0]

@test
def test_sequential_modules():
    torch.manual_seed(0)
    m = nn.Sequential(nn.Conv2d(1, 2, 3), nn.BatchNorm2d(2), nn.ELU(), nn.Flatten(), nn.Linear(2 * 3 * 3, 4))
    EQ("seq_keys", list(m.state_dict().keys()))
    SHOW("seq_out", m(X([2, 1, 5, 5], 11, torch.float32)), 1e-5)
    assert len(m) == 5
    assert len(m.parameters()) == 6
    sd = m.state_dict()
    torch.manual_seed(1)
    m2 = nn.Sequential(nn.Conv2d(1, 2, 3), nn.BatchNorm2d(2), nn.ELU(), nn.Flatten(), nn.Linear(2 * 3 * 3, 4))
    m2.load_state_dict(sd)
    xin = X([2, 1, 5, 5], 11, torch.float32)
    assert m2(xin).tolist() == m(xin).tolist()
    m.zero_grad()
    m.train(False)
    assert not m[1].training

@test
def test_attention():
    torch.manual_seed(0)
    mha = nn.MultiheadAttention(8, 2, batch_first=True)
    q = X([2, 3, 8], 12, torch.float32)
    o, a = mha(q, q, q)
    SHOW("mha_out", o, 1e-4)
    SHOW("mha_w", a.__val__(), 1e-5)
    o2, _ = mha(q, q, q, need_weights=False)
    SHOW("mha_out", o2, 1e-4)
    torch.manual_seed(0)
    tl = nn.TransformerEncoderLayer(8, 2, 16, 0.0, activation="gelu", batch_first=True, norm_first=True)
    SHOW("tel_out", tl(q), 1e-4)
    EQ("tel_keys", list(tl.state_dict().keys()))

test_conv2d()
test_conv1d_pad()
test_pool()
test_pool1d_shapes()
test_batchnorm()
test_activations_norms()
test_losses()
test_dropout()
test_sequential_modules()
test_attention()
