# Expected values generated by test/torch/gen_nn_expected.py (torch 2.15.0).
import torch
import torch.nn as nn
import torch.nn.functional as F

def X(shape: List[int], seed: int, dtype = torch.float64) -> torch.Tensor:
    n = 1
    for s in shape: n *= s
    return ((torch.arange(n, dtype=torch.float64) * 0.37 + float(seed)).sin() * 2.0).reshape(shape).to(dtype)

def close(t: torch.Tensor, exp: List[float], rtol: float) -> bool:
    v = t.detach().contiguous().reshape([-1]).double().tolist()
    if len(v) != len(exp):
        print("len mismatch", len(v), len(exp))
        return False
    scale = 0.0
    for e in exp: scale = max(scale, abs(e))
    for i in range(len(v)):
        if abs(v[i] - exp[i]) > rtol * max(abs(exp[i]), 1e-3 * scale):
            print("mismatch at", i, v[i], exp[i])
            return False
    return True

def closef(a: float, b: float, rtol: float) -> bool:
    return abs(a - b) <= rtol * abs(b)

def run(kind: int) -> nn.Linear:
    torch.manual_seed(0)
    lin = nn.Linear(3, 2).double()
    xin = X([4, 3], 13)
    opt: torch.optim.Optimizer = torch.optim.SGD(lin.parameters(), lr=0.1, momentum=0.9, weight_decay=0.01, nesterov=True)
    if kind == 1:
        opt = torch.optim.Adam(lin.parameters(), lr=0.01, weight_decay=0.1)
    elif kind == 2:
        opt = torch.optim.AdamW(lin.parameters(), lr=0.01, weight_decay=0.1)
    elif kind == 3:
        opt = torch.optim.AdamW(lin.parameters(), lr=0.01, amsgrad=True)
    for _ in range(3):
        opt.zero_grad()
        ((lin(xin) ** 2).mean()).backward()
        opt.step()
    return lin

@test
def test_optimizers():
    SHOW("sgd_w", run(0).weight, 1e-13)
    SHOW("adam_w", run(1).weight, 1e-13)
    SHOW("adamw_w", run(2).weight, 1e-13)
    SHOW("adamw_ams", run(3).weight, 1e-13)

@test
def test_schedulers():
    opt = torch.optim.SGD([torch.zeros([1]).requires_grad_()], lr=0.1)
    sch = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=5, eta_min=0.001)
    lrs = List[float]()
    for _ in range(12):
        opt.step()
        sch.step()
        lrs.append(opt.param_groups[0]["lr"])
    EQ("cos_lrs", lrs)
    opt2 = torch.optim.SGD([torch.zeros([1]).requires_grad_()], lr=0.1)
    sch2 = torch.optim.lr_scheduler.StepLR(opt2, 3, 0.5)
    lrs = []
    for _ in range(7):
        opt2.step()
        sch2.step()
        lrs.append(opt2.param_groups[0].lr)
    EQ("step_lrs", lrs)

test_optimizers()
test_schedulers()
