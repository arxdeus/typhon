# Expected values generated by test/torch/gen_nn_expected.py (torch 2.15.0).
import torch
import torch.nn as nn
import torch.nn.functional as F

def X(shape: List[int], seed: int, dtype = torch.float64) -> torch.Tensor:
    n = 1
    for s in shape: n *= s
    return ((torch.arange(n, dtype=torch.float64) * 0.37 + float(seed)).sin() * 2.0).reshape(shape).to(dtype)

def close(t: torch.Tensor, exp: List[float], rtol: float) -> bool:
    v = t.detach().contiguous().reshape([-1]).double().tolist()
    if len(v) != len(exp):
        print("len mismatch", len(v), len(exp))
        return False
    scale = 0.0
    for e in exp: scale = max(scale, abs(e))
    for i in range(len(v)):
        if abs(v[i] - exp[i]) > rtol * max(abs(exp[i]), 1e-3 * scale):
            print("mismatch at", i, v[i], exp[i])
            return False
    return True

def closef(a: float, b: float, rtol: float) -> bool:
    return abs(a - b) <= rtol * abs(b)

@test
def test_conv_transpose():
    torch.manual_seed(0)
    ct = nn.ConvTranspose2d(4, 6, (2, 3), stride=(2, 1), padding=(1, 1), output_padding=(1, 0), groups=2, dilation=(1, 2)).double()
    x = X([2, 4, 3, 5], 1).requires_grad_()
    y = ct(x)
    SHOW("ct2_w", ct.weight, 1e-7)
    EQ("ct2_shape", list(y.shape))
    SHOW("ct2_y", y, 1e-12)
    (y * y).sum().backward()
    SHOW("ct2_gx", x.grad.__val__(), 1e-12)
    SHOW("ct2_gw", ct.weight.grad.__val__(), 1e-12)
    SHOW("ct2_gb", ct.bias.__val__().grad.__val__(), 1e-12)
    torch.manual_seed(0)
    ct1 = nn.ConvTranspose1d(3, 2, 4, stride=3, padding=1).double()
    SHOW("ct1_y", ct1(X([2, 3, 5], 2)), 1e-12)

@test
def test_lstm():
    torch.manual_seed(0)
    m = nn.LSTM(3, 4, num_layers=2, batch_first=True, bidirectional=True).double()
    xi = X([2, 5, 3], 3).requires_grad_()
    o, hc = m(xi, None)
    h = hc[0]
    EQ("lstm_keys", list(m.state_dict().keys()))
    SHOW("lstm_out", o, 1e-12)
    SHOW("lstm_h", h, 1e-12)
    (o.sum() + h.sum()).backward()
    SHOW("lstm_gx", xi.grad.__val__(), 1e-12)

@test
def test_gru():
    torch.manual_seed(0)
    m = nn.GRU(3, 4, num_layers=2, batch_first=True, bidirectional=True).double()
    xi = X([2, 5, 3], 3).requires_grad_()
    o, h = m(xi, None)
    EQ("gru_keys", list(m.state_dict().keys()))
    SHOW("gru_out", o, 1e-12)
    SHOW("gru_h", h, 1e-12)
    (o.sum() + h.sum()).backward()
    SHOW("gru_gx", xi.grad.__val__(), 1e-12)

@test
def test_rnn():
    torch.manual_seed(0)
    m = nn.RNN(3, 4, num_layers=2, batch_first=True, bidirectional=True).double()
    xi = X([2, 5, 3], 3).requires_grad_()
    o, h = m(xi, None)
    EQ("rnn_keys", list(m.state_dict().keys()))
    SHOW("rnn_out", o, 1e-12)
    SHOW("rnn_h", h, 1e-12)
    (o.sum() + h.sum()).backward()
    SHOW("rnn_gx", xi.grad.__val__(), 1e-12)

@test
def test_norm_interp():
    torch.manual_seed(0)
    inorm = nn.InstanceNorm1d(3, affine=True).double()
    SHOW("inorm", inorm(X([2, 3, 6], 4)), 1e-12)
    SHOW("interp_nearest", F.interpolate(X([1, 2, 5], 5), size=8, mode="nearest"), 1e-15)
    SHOW("interp_linear", F.interpolate(X([1, 2, 5], 5), scale_factor=2.0, mode="linear"), 1e-13)
    SHOW("interp_linear_ac", F.interpolate(X([1, 2, 5], 5), size=7, mode="linear", align_corners=True), 1e-13)
    SHOW("upsample", nn.Upsample(scale_factor=3.0)(X([1, 1, 4], 6)), 1e-15)
    SHOW("gnorm_mod", nn.GroupNorm(2, 4).double()(X([2, 4, 3], 7)), 1e-12)

test_conv_transpose()
test_lstm()
test_gru()
test_rnn()
test_norm_interp()
