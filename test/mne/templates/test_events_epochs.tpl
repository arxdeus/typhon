def mk(nch: int, n: int, k: float):
    out = np.empty((nch, n))
    for i in range(nch):
        for j in range(n):
            out[i, j] = (np.sin(0.05 * (i + 1) * j + k) + 0.3 * np.cos(0.31 * j * (i + 2) + 0.5 * i)) * 1e-5
    return out


info = mne.create_info(["Fz", "Cz", "Pz", "EOG", "STI", "STI2"], 100.0,
                       ["eeg", "eeg", "eeg", "eog", "stim", "stim"])
d = mk(6, 1000, 0.3)
d[4, :] = 0.0
d[5, :] = 0.0
for s, v in [(50, 1), (150, 2), (152, 3), (260, 1), (400, 2), (520, 4), (530, 1), (700, 2), (850, 1), (990, 2)]:
    d[4, s:s + 4] = float(v)
d[4, 600:620] = 5.0
d[4, 620:625] = 3.0
d[5, 300:310] = 7.0
d[5, 305:309] = 0.0
raw = mne.io.RawArray(d, info, first_samp=20)

ev = mne.find_events(raw, stim_channel="STI")

# Epochs construction
ids = {"auditory/left": 1, "auditory/right": 2, "visual/left": 3, "visual/right": 4}
ep = mne.Epochs(raw, ev, ids, tmin=-0.1, tmax=0.2, baseline=(None, 0), preload=True,
                on_missing="ignore", event_repeated="drop")
check("ep_len", [len(ep), ep.times.shape[0], ep.tmin, ep.tmax])
check("ep_sel", ep.selection)
check("ep_d", ep.get_data()[:2, :2, :4], 1e-9, 1e-18)
check("ep_d_units", ep.get_data(picks="eeg", units="uV", tmin=0.0, tmax=0.05)[1], 1e-9, 1e-12)
check("ep_left", [len(ep["left"]), len(ep["auditory"]), len(ep["auditory/left"]),
                  len(ep[["visual", "right"]]), len(ep["visual/right"])])
check("ep_slice", ep[1:4].events)
check("ep_idx", ep[[0, 2]].events)
e2 = ep.copy().crop(tmin=0.0, tmax=0.1)
check("ep_crop", [e2.times.shape[0], e2.tmin])
check("ep_crop_d", e2.get_data()[0, 0, :3], 1e-9, 1e-18)
e3 = mne.Epochs(raw, ev, ids, tmin=-0.1, tmax=0.2, baseline=None, preload=True,
                on_missing="ignore", event_repeated="drop", detrend=1, decim=2)
check("ep_detrend_decim", e3.get_data()[1, :2, :], 1e-9, 1e-18)
check("ep_decim_times", e3.times)
e4 = mne.Epochs(raw, ev, ids, tmin=-0.1, tmax=0.2, baseline=None, preload=True,
                on_missing="ignore", event_repeated="drop", flat={"eeg": 1e-4},
                reject={"eog": 1e-5}, reject_tmin=0.0)
checks("ep_dlog", [";".join(x) for x in e4.drop_log])
e5 = ep.copy().apply_baseline((0.0, 0.1))
check("ep_bl", e5.get_data()[0, 0, :4], 1e-9, 1e-18)
check("ep_bl_t", [e5.baseline[0], e5.baseline[1]])
e6 = ep.copy().resample(50.0)
check("ep_rs", e6.get_data()[0, :2, :], 1e-6, 1e-16)
e7 = ep.copy().filter(None, 20.0)
check("ep_filt", e7.get_data()[0, :2, :5], 1e-6, 1e-16)
e8 = ep.copy()
e8.equalize_event_counts(["auditory", "visual"])
check("ep_eq", e8.events)
checks("ep_eq_dlog", [";".join(x) for x in e8.drop_log])

# Evoked
av = ep.average()
check("ev_d", av.data[:3, :4], 1e-9, 1e-18)
check("ev_n", [av.nave, av.first, av.last])
checks("ev_comment", [av.comment, ep["auditory"].average().comment])
avm = ep.average(method="median")
check("ev_med", avm.data[:2, :4], 1e-9, 1e-18)
evs = ep.average(by_event_type=True)
checks("ev_by_type", [e.comment for e in evs])
ch, lat, amp = av.get_peak(ch_type="eeg", return_amplitude=True)
checks("peak_ch", [ch])
check("peak", [lat, amp], 1e-9, 1e-18)
ch2, lat2 = av.get_peak(ch_type="eeg", tmin=0.0, tmax=0.1, mode="neg")
check("peak2", [lat2])
c = mne.combine_evoked([evs[0], evs[1]], weights="nave")
check("comb_nave", c.data[0, :4], 1e-9, 1e-18)
