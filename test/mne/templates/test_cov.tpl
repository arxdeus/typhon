import numpy as np
import mne


def make_data(n_ep: int, n_t: int, seed: int):
    rng = np.random.RandomState(seed)
    mix = rng.randn(6, 6) * 0.3 + np.eye(6)
    Z = rng.randn(n_ep, 6, n_t)
    X = np.empty((n_ep, 6, n_t))
    for e in range(n_ep):
        X[e] = np.dot(mix, Z[e])
    X[:, :2] *= 1e-12
    X[:, 2:4] *= 1e-11
    X[:, 4:] *= 1e-5
    return X


def close(name: str, a, b: List[float], rtol: float = 1e-8):
    x = np.asarray(a, dtype=float).ravel()
    if x.shape[0] != len(b):
        print("TEST FAILED:", name, "length", x.shape[0], len(b))
        return
    scale = 0.0
    for v in b:
        scale = max(scale, abs(v))
    for i in range(len(b)):
        if abs(x[i] - b[i]) > rtol * max(abs(b[i]), 1e-6 * scale):
            print("TEST FAILED:", name, "at", i, x[i], b[i])
            return


names = ["M1", "M2", "G1", "G2", "E1", "E2"]
types = ["mag", "mag", "grad", "grad", "eeg", "eeg"]
info = mne.create_info(names, 100.0, types)
X = make_data(12, 30, 0)
ev = np.zeros((12, 3), dtype=int)
for i in range(12):
    ev[i, 0] = i * 40
    ev[i, 2] = 1 + (i % 2)
ep = mne.EpochsArray(X, info, ev, tmin=-0.1, event_id={"a": 1, "b": 2}, baseline=(None, 0))


@test
def test_methods():
    close("empirical", mne.compute_covariance(ep, method="empirical").data, @@c_empirical@@)
    close("diagonal_fixed", mne.compute_covariance(ep, method="diagonal_fixed").data, @@c_diagonal_fixed@@)
    close("ledoit_wolf", mne.compute_covariance(ep, method="ledoit_wolf").data, @@c_ledoit_wolf@@)
    close("oas", mne.compute_covariance(ep, method="oas").data, @@c_oas@@)
    close("shrinkage", mne.compute_covariance(ep, method="shrinkage").data, @@c_shrinkage@@)
    close("shrunk", mne.compute_covariance(ep, method="shrunk").data, @@c_shrunk@@)
    close("nokeep", mne.compute_covariance(ep, keep_sample_mean=False).data, @@c_nokeep@@)
    c = mne.compute_covariance(ep, tmin=-0.05, tmax=0.1)
    close("tw", c.data, @@c_tw@@)
    close("tw_nfree", [c.nfree], @@c_tw_nfree@@)
    c3 = mne.compute_covariance(ep, method="shrinkage", method_params={"shrinkage": {"shrinkage": 0.3}})
    close("shr03", c3.data, @@c_shr03@@)
    c4 = mne.compute_covariance(ep, method="diagonal_fixed",
                                method_params={"diagonal_fixed": {"eeg": 0.2, "mag": 0.05}})
    close("diagfix2", c4.data, @@c_diagfix2@@)
test_methods()


@test
def test_auto():
    cs = mne.compute_covariance(ep, method="auto", return_estimators=True)
    got = [c.method.__val__() for c in cs]
    if got != @@auto_methods@@:
        print("TEST FAILED: auto order", got)
    close("auto_ll", [c.loglik.__val__() for c in cs], @@auto_logliks@@, 1e-7)
    close("auto_best", cs[0].data, @@auto_best@@)
    cs2 = mne.compute_covariance(ep, method=["empirical", "oas"], return_estimators=True, cv=4)
    close("two_ll", [c.loglik.__val__() for c in cs2], @@two_logliks@@, 1e-7)
test_auto()


ep2 = ep.copy().set_eeg_reference(projection=True)
info2 = ep2.info
emp = mne.compute_covariance(ep)
emp2 = mne.compute_covariance(ep2)


@test
def test_proj_raw_adhoc():
    close("proj_lw", mne.compute_covariance(ep2, method="ledoit_wolf").data, @@c_proj_lw@@)
    raw = mne.io.RawArray(np.hstack([X[e] for e in range(12)]), info)
    rc = mne.compute_raw_covariance(raw)
    close("raw_emp", rc.data, @@raw_emp@@)
    close("raw_nfree", [rc.nfree], @@raw_nfree@@)
