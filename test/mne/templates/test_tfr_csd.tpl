import numpy as np
import mne
from mne.time_frequency import (morlet, fwhm, tfr_array_morlet, tfr_array_multitaper,
                                tfr_array_stockwell, stft, istft, stftfreq, tfr_morlet,
                                tfr_multitaper, csd_array_fourier, csd_array_multitaper,
                                csd_array_morlet, psd_array_welch, compute_tfr)


def sig(n_ep: int, n_ch: int, n_t: int, sf: float = 100.0):
    X = np.empty((n_ep, n_ch, n_t))
    for e in range(n_ep):
        for c in range(n_ch):
            for i in range(n_t):
                t = i / sf
                X[e, c, i] = (np.sin(2 * np.pi * (8 + 2 * c) * t + 0.3 * e)
                              + 0.5 * np.cos(2 * np.pi * 21.0 * t * (1 + 0.05 * e))
                              + 0.2 * np.sin(0.7 * i * (c + 1) + e))
    return X


def close(a, b, rtol: float = 1e-9, atol: float = 0.0) -> bool:
    x = np.asarray(a, dtype=float).ravel()
    z = np.asarray(b, dtype=float).ravel()
    if x.shape[0] != z.shape[0]:
        print("length mismatch", x.shape[0], z.shape[0])
        return False
    scale = float(np.max(np.abs(z))) if z.shape[0] > 0 else 0.0
    for i in range(x.shape[0]):
        if abs(x[i] - z[i]) > atol + rtol * max(abs(z[i]), 1e-6 * scale):
            print("mismatch at", i, x[i], z[i])
            return False
    return True


@test
def test_tfr_containers():
    X = sig(4, 3, 200)
    freqs = np.array([6.0, 10.0, 15.0, 22.0])
    info = mne.create_info(["a", "b", "c"], 100.0, "eeg")
    ep = mne.EpochsArray(X * 1e-6, info, tmin=-0.5)
    pw, it = tfr_morlet(ep, freqs, n_cycles=4.0, return_itc=True, decim=2)
    assert close(pw.data[:, :, ::5], @@tm_p@@)
    assert close(it.data[:, :, ::5], @@tm_i@@)
    assert close(pw.times[::5], @@tm_t@@)
    b = pw.copy().apply_baseline((-0.5, -0.1), mode="logratio")
    assert close(b.data[:, :, ::5], @@bl_lr@@, 1e-8, 1e-12)
    assert close(pw.copy().apply_baseline((None, 0.0), mode="mean").data[:, :, ::7], @@bl_mean@@, 1e-8, 1e-24)
    assert close(pw.copy().apply_baseline((None, 0.0), mode="ratio").data[:, :, ::7], @@bl_ratio@@, 1e-8)
    assert close(pw.copy().apply_baseline((None, 0.0), mode="percent").data[:, :, ::7], @@bl_percent@@, 1e-8, 1e-12)
    assert close(pw.copy().apply_baseline((None, 0.0), mode="zscore").data[:, :, ::7], @@bl_zscore@@, 1e-8, 1e-12)
    assert close(pw.copy().apply_baseline((None, 0.0), mode="zlogratio").data[:, :, ::7], @@bl_zlogratio@@, 1e-8, 1e-12)
    cr = pw.copy().crop(-0.2, 0.6, fmin=8.0, fmax=20.0)
    assert close(cr.data[:, :, ::3], @@cr_d@@)
    assert close(cr.times, @@cr_t@@)
    assert close(cr.freqs, @@cr_f@@)
    etf = tfr_morlet(ep, freqs, n_cycles=3.0, return_itc=False, average=False, use_fft=True)
    assert close(etf.data[:, :, :, ::17], @@et_d@@)
    assert close(etf.average().data[:, :, ::11], @@et_avg@@)
    assert close(etf.average(method="median").data[:, :, ::11], @@et_med@@)
    mt = tfr_multitaper(ep, freqs, n_cycles=4.0, time_bandwidth=4.0, return_itc=False)
    assert close(mt.data[:, :, ::9], @@tmt@@, 1e-8)
    ct = compute_tfr(ep, "morlet", freqs, n_cycles=4.0, average=True, return_itc=False, tmin=-0.3, tmax=0.8)
    assert close(ct.data[:, :, ::9], @@ct@@)
    assert close(ct.times[::9], @@ct_t@@)


@test
def test_csd():
    X = sig(4, 3, 200)
    cf = csd_array_fourier(X, 100.0, fmin=5, fmax=25, n_fft=128)
    assert close(np.array(cf.frequencies), @@cf_f@@)
    assert close(cf._data.real[:, ::3], @@cf_r@@, 1e-8, 1e-14)
    assert close(cf._data.imag[:, ::3], @@cf_i@@, 1e-8, 1e-14)
    assert close(np.abs(cf.mean(fmin=8, fmax=15).get_data()), @@cf_m@@, 1e-8)
    cm = csd_array_multitaper(X, 100.0, fmin=5, fmax=25, tmin=0.2, tmax=1.5)
    assert close(cm._data.real[:, ::2], @@cm_r@@, 1e-8, 1e-14)
    assert close(cm._data.imag[:, ::2], @@cm_i@@, 1e-8, 1e-14)
    cma = csd_array_multitaper(X, 100.0, fmin=5, fmax=25, adaptive=True, bandwidth=6.0)
    # off-diagonal terms nearly cancel; adaptive weights converge to 1e-10 only
    assert close(np.abs(cma._data[:, ::2]), @@cma@@, 1e-6, 1e-7)
    cw = csd_array_morlet(X, 100.0, [8.0, 12.0, 20.0], n_cycles=5, tmin=0.3, tmax=1.6)
    assert close(cw._data.real, @@cw_r@@, 1e-8, 1e-14)
    assert close(cw._data.imag, @@cw_i@@, 1e-8, 1e-14)
    assert close(np.abs(cw.get_data(frequency=12.0)), @@cw_g@@, 1e-8)
    assert close(np.array([cw.tmin, cw.tmax]), @@cw_tm@@)


@test
def test_psd_welch_options():
    X = sig(4, 3, 200)
    pm, fq = psd_array_welch(X, 100.0, fmin=2, fmax=40, n_fft=64, n_overlap=32, average="median")
    assert close(pm[:, :, ::3], @@pw_med@@)
    pm, fq = psd_array_welch(X, 100.0, n_fft=64, n_per_seg=50, window="hann", average="mean")
    assert close(pm[:, :, ::4], @@pw_hann@@)
    pm, fq = psd_array_welch(X, 100.0, n_fft=64, window=("tukey", 0.25))
    assert close(pm[:, :, ::4], @@pw_tuk@@)


test_tfr_containers()
test_csd()
test_psd_welch_options()
