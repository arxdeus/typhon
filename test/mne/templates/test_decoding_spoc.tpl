def make(n_ep: int = 24, n_ch: int = 4, n_t: int = 40):
    X = np.empty((n_ep, n_ch, n_t))
    y = np.arange(n_ep) % 2
    for e in range(n_ep):
        for c in range(n_ch):
            for t in range(n_t):
                v = np.sin(0.31 * t * (c + 1) + 0.17 * e) + 0.6 * np.cos(0.13 * t * (e % 5 + 1) + c) + 0.1 * c
                if c % 2 == 0:
                    v += y[e] * 0.9 * np.sin(0.5 * t)
                X[e, c, t] = v
    return X, y


def close(a, b, rtol: float = 1e-9, atol: float = 0.0) -> bool:
    x = np.asarray(a, dtype=float).ravel()
    z = np.asarray(b, dtype=float).ravel()
    if x.shape[0] != z.shape[0]:
        print("length mismatch", x.shape[0], z.shape[0])
        return False
    scale = float(np.max(np.abs(z))) if z.shape[0] > 0 else 0.0
    for i in range(x.shape[0]):
        if abs(x[i] - z[i]) > atol + rtol * max(abs(z[i]), 1e-6 * scale):
            print("mismatch at", i, x[i], z[i])
            return False
    return True


@test
def test_spoc_ems():
    X, y = make()
    yc = np.sin(np.arange(24) * 0.7) + 0.1 * np.arange(24)
    Xs = X.copy()
    for e in range(24):
        Xs[e, 1] *= 1.0 + 0.5 * yc[e]
    sp = SPoC(n_components=2)
    F = sp.fit_transform(Xs, yc)
    assert close(F[:5], @@spoc_f@@, 1e-8)
    assert close(sp.evals_, @@spoc_ev@@, 1e-8)
    assert close(np.sort(np.abs(sp.filters_), axis=1), @@spoc_fl@@, 1e-7)
    sp2 = SPoC(n_components=2, log=False, reg=0.1)
    assert close(sp2.fit_transform(Xs, yc)[:5], @@spoc2@@, 1e-7)
    ems = EMS()
    T = ems.fit_transform(X, y)
    assert close(ems.filters_[:, ::7], @@ems_f@@)
    assert close(T[:3, ::7], @@ems_t@@)
    info2 = mne.create_info(4, 100.0, "eeg")
