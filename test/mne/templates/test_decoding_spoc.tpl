    for i in range(24):
        ev[i, 0] = i * 50
        ev[i, 2] = y[i] + 1
    ep = mne.EpochsArray(X * 1e-6, info2, events=ev, event_id={"a": 1, "b": 2})
    sur, filt, cond = compute_ems(ep)
    assert close(sur[:4, ::5], @@cems_s@@)
