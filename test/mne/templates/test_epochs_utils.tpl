def mk(nch: int, n: int, k: float):
    out = np.empty((nch, n))
    for i in range(nch):
        for j in range(n):
            out[i, j] = np.sin(0.05 * (i + 1) * j + k) + 0.3 * np.cos(0.31 * j * (i + 2) + 0.5 * i) + 0.2 * np.sin(2.0 * j)
    return out


names = ['Fp1', 'Fz', 'Cz', 'Pz', 'O1', 'O2']
sf = 100.0
data = mk(6, 1500, 0.3) * 1e-5
raw = mne.io.RawArray(data, mne.create_info(names, sf, 'eeg'))
ev = np.array([[100, 0, 1], [200, 0, 2], [300, 0, 1], [400, 0, 2], [500, 0, 1], [600, 0, 1], [700, 0, 2], [800, 0, 1], [900, 0, 1], [1000, 0, 1]])
ep = mne.Epochs(raw, ev, tmin=-0.2, tmax=0.5, baseline=None, preload=True)

# concatenate
ea = ep['1']
eb = ep['2']
cc = mne.concatenate_epochs([ea.copy(), eb.copy()])
check("cc_len", [len(cc)])
check("cc_ev", cc.events)
