@test
def test_apply_forward():
    data = np.empty((5, 10))
    for v in range(5):
        for t in range(10):
            data[v, t] = np.sin(t * 0.3 + v) * 1e-9
    stc = mne.VolSourceEstimate(data, [np.arange(5)], tmin=0.01, tstep=0.01)
    ev = mne.apply_forward(fwd, stc, info)
    close("apply_fwd", ev.data, @@apply_fwd@@)
    close("apply_fwd_times", ev.times, @@apply_fwd_times@@)
    vdata = np.cos(np.arange(5 * 3 * 4).reshape(5, 3, 4).astype(float) * 0.2) * 1e-9
    vstc = mne.VolVectorSourceEstimate(vdata, [np.arange(5)], tmin=0.0, tstep=0.01)
    ev2 = mne.apply_forward(fwd, vstc, info)
    close("apply_fwd_vec", ev2.data, @@apply_fwd_vec@@)
    raw = mne.apply_forward_raw(fwd, stc, info, start=2, stop=8)
    close("apply_fwd_raw", raw.get_data(), @@apply_fwd_raw@@)
    close("apply_fwd_raw_first", [raw.first_samp], @@apply_fwd_raw_first@@)
test_apply_forward()
