import numpy as np
import mne


def close(name: str, a, b: List[float], rtol: float = 1e-8):
    x = np.asarray(a, dtype=float).ravel()
    if x.shape[0] != len(b):
        print("TEST FAILED:", name, "length", x.shape[0], len(b))
        return
    scale = 0.0
    for v in b:
        scale = max(scale, abs(v))
    for i in range(len(b)):
        if abs(x[i] - b[i]) > rtol * max(abs(b[i]), 1e-6 * scale):
            print("TEST FAILED:", name, "at", i, x[i], b[i])
            return


def sph(n: int, R: float, seed: int, z0: float = 0.04):
    r = np.random.RandomState(seed)
    th = r.uniform(0.2, 1.2, n)
    ph = r.uniform(0, 2 * np.pi, n)
    out = np.empty((n, 3))
    for i in range(n):
        out[i, 0] = R * np.sin(th[i]) * np.cos(ph[i])
        out[i, 1] = R * np.sin(th[i]) * np.sin(ph[i])
        out[i, 2] = R * np.cos(th[i]) + z0
    return out


def cross(a, b):
    return np.array([a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]])


def make_info():
    eeg = sph(8, 0.09, 1)
    meg = sph(6, 0.12, 3)
    names = ["E%d" % i for i in range(8)] + ["M%d" % i for i in range(6)]
    types = ["eeg"] * 8 + ["mag"] * 3 + ["grad"] * 3
    info = mne.create_info(names, 100.0, types)
    for i in range(8):
        for q in range(3):
            info.locs[i][q] = eeg[i, q]
        for q in range(3, 6):
            info.locs[i][q] = 0.0
    c0 = np.array([0.0, 0.0, 0.04])
    for k in range(6):
        p = meg[k]
        ez = (p - c0) / np.linalg.norm(p - c0)
        ex = cross(np.array([0.0, 1.0, 0.0]), ez)
        ex /= np.linalg.norm(ex)
        ey = cross(ez, ex)
        for q in range(3):
            info.locs[8 + k][q] = p[q]
            info.locs[8 + k][3 + q] = ex[q]
            info.locs[8 + k][6 + q] = ey[q]
            info.locs[8 + k][9 + q] = ez[q]
    return info


info = make_info()
sphere = mne.make_sphere_model(r0=(0.0, 0.0, 0.04), head_radius=0.09)
fit_mu = sphere.mu.copy()
fit_lam = sphere.lambda_.copy()
# The Berg-Scherg COBYLA fit converges to a point within rhoend=1e-4 of
# scipy's but not bit-identical; pin mne's fitted parameters so the forward
# physics is compared exactly.
sphere.mu = np.array(@@mu@@)
sphere.lambda_ = np.array(@@lam@@)
rr = sph(5, 0.05, 2)
nn = sph(5, 1.0, 4, z0=0.0)
src = mne.setup_volume_source_space(pos={"rr": rr, "nn": nn})
fwd = mne.make_forward_solution(info, None, src, sphere)


@test
def test_sphere_model():
    # COBYLA path: loose tolerance (fit is iterative)
    close("mu", fit_mu, @@mu@@, 1e-1)
    close("lam", fit_lam, @@lam@@, 1e-1)
    s2 = mne.make_sphere_model(r0=(0.0, 0.01, 0.03), head_radius=0.1,
                               relative_radii=(0.88, 0.95, 1.0), sigmas=(0.3, 0.006, 0.3))
    close("mu2", s2["mu"], @@mu2@@, 1e-1)
    close("lam2", s2["lambda"], @@lam2@@, 1e-1)
test_sphere_model()


@test
def test_forward():
    close("fwd_free", fwd["sol"]["data"], @@fwd_free@@)
    if fwd.ch_names != @@fwd_names@@:
        print("TEST FAILED: fwd names", fwd.ch_names)
    f2 = mne.convert_forward_solution(fwd, surf_ori=True)
    close("fwd_surf", f2["sol"]["data"], @@fwd_surf@@)
    close("fwd_surf_nn", f2["source_nn"], @@fwd_surf_nn@@)
    f3 = mne.convert_forward_solution(fwd, force_fixed=True)
    close("fwd_fixed", f3["sol"]["data"], @@fwd_fixed@@)
    fe = mne.make_forward_solution(info, None, src, sphere, meg=False)
    close("fwd_eeg", fe["sol"]["data"], @@fwd_eeg@@)
    s0 = mne.make_sphere_model(r0=(0.0, 0.0, 0.04), head_radius=None)
    fm = mne.make_forward_solution(info, None, src, s0, eeg=False)
    close("fwd_meg0", fm["sol"]["data"], @@fwd_meg0@@)
    dp = mne.forward.compute_depth_prior(fwd, info, exp=0.8, limit=10.0)
    close("depth_spec", dp, @@depth_spec@@)
    dp2 = mne.forward.compute_depth_prior(fwd, info, exp=0.5, limit_depth_chs=True, combine_xyz="fro")
    close("depth_fro", dp2, @@depth_fro@@)
    close("orient", mne.forward.compute_orient_prior(f2, loose=0.3), @@orient@@)
test_forward()


