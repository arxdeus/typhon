import numpy as np
import mne
from mne.time_frequency import (morlet, fwhm, tfr_array_morlet, tfr_array_multitaper,
                                tfr_array_stockwell, stft, istft, stftfreq, tfr_morlet,
                                tfr_multitaper, csd_array_fourier, csd_array_multitaper,
                                csd_array_morlet, psd_array_welch, compute_tfr)


def sig(n_ep: int, n_ch: int, n_t: int, sf: float = 100.0):
    X = np.empty((n_ep, n_ch, n_t))
    for e in range(n_ep):
        for c in range(n_ch):
            for i in range(n_t):
                t = i / sf
                X[e, c, i] = (np.sin(2 * np.pi * (8 + 2 * c) * t + 0.3 * e)
                              + 0.5 * np.cos(2 * np.pi * 21.0 * t * (1 + 0.05 * e))
                              + 0.2 * np.sin(0.7 * i * (c + 1) + e))
    return X


def close(a, b, rtol: float = 1e-9, atol: float = 0.0) -> bool:
    x = np.asarray(a, dtype=float).ravel()
    z = np.asarray(b, dtype=float).ravel()
    if x.shape[0] != z.shape[0]:
        print("length mismatch", x.shape[0], z.shape[0])
        return False
    scale = float(np.max(np.abs(z))) if z.shape[0] > 0 else 0.0
    for i in range(x.shape[0]):
        if abs(x[i] - z[i]) > atol + rtol * max(abs(z[i]), 1e-6 * scale):
            print("mismatch at", i, x[i], z[i])
            return False
    return True


@test
def test_tfr_array_multitaper():
    X = sig(4, 3, 200)
    freqs = np.array([6.0, 10.0, 15.0, 22.0])
    assert close(tfr_array_multitaper(X, 100.0, freqs, n_cycles=4.0, time_bandwidth=4.0, output="power")[:, :, :, ::7], @@mt_p@@, 1e-8)
    assert close(tfr_array_multitaper(X, 100.0, freqs, n_cycles=freqs / 2, time_bandwidth=3.0, output="avg_power", decim=2)[:, :, ::5], @@mt_ap@@, 1e-8)
    mc, mw = tfr_array_multitaper(X, 100.0, freqs, n_cycles=4.0, output="complex", return_weights=True)
    assert close(np.abs(mc[:, :, :, :, ::11]), @@mt_c@@, 1e-8)
    assert close(mw, @@mt_w@@, 1e-9)
    apim = tfr_array_multitaper(X, 100.0, freqs, n_cycles=4.0, output="avg_power_itc")
    assert close(apim.real[:, :, ::9], @@mt_apir@@, 1e-8)
    assert close(apim.imag[:, :, ::9], @@mt_apii@@, 1e-8)


@test
def test_stockwell_stft():
    X = sig(4, 3, 200)
    ps, itc, fr = tfr_array_stockwell(X, 100.0, fmin=5.0, fmax=30.0, return_itc=True)
    assert close(fr, @@st_f@@)
    assert close(ps[:, :, ::13], @@st_p@@)
    assert close(itc[:, :, ::13], @@st_i@@, 1e-7)
    ps, _, fr = tfr_array_stockwell(X, 100.0, n_fft=512, width=1.5, decim=4)
    assert close(fr[::7], @@st2_f@@)
    assert close(ps[:, ::7, ::5], @@st2_p@@)
    S = stft(X[0], 32, 8)
    assert list(S.shape) == @@stft_shape@@
    assert close(S.real[:, ::3, ::4], @@stft_r@@, 1e-9, 1e-12)
    assert close(S.imag[:, ::3, ::4], @@stft_i@@, 1e-9, 1e-12)
    assert close(istft(S, 8, 200)[:, ::9], @@istft@@, 1e-9, 1e-12)
    assert close(stftfreq(32, 100.0), @@stftf@@)


test_tfr_array_multitaper()
test_stockwell_stft()
