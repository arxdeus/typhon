def sig(n_ep: int, n_ch: int, n_t: int, sf: float = 100.0):
    X = np.empty((n_ep, n_ch, n_t))
    for e in range(n_ep):
        for c in range(n_ch):
            for i in range(n_t):
                t = i / sf
                X[e, c, i] = (np.sin(2 * np.pi * (8 + 2 * c) * t + 0.3 * e)
                              + 0.5 * np.cos(2 * np.pi * 21.0 * t * (1 + 0.05 * e))
                              + 0.2 * np.sin(0.7 * i * (c + 1) + e))
    return X


def close(a, b, rtol: float = 1e-9, atol: float = 0.0) -> bool:
    x = np.asarray(a, dtype=float).ravel()
    z = np.asarray(b, dtype=float).ravel()
    if x.shape[0] != z.shape[0]:
        print("length mismatch", x.shape[0], z.shape[0])
        return False
    scale = float(np.max(np.abs(z))) if z.shape[0] > 0 else 0.0
    for i in range(x.shape[0]):
        if abs(x[i] - z[i]) > atol + rtol * max(abs(z[i]), 1e-6 * scale):
            print("mismatch at", i, x[i], z[i])
            return False
    return True


@test
def test_wavelets():
    freqs = np.array([6.0, 10.0, 15.0, 22.0])
    W = morlet(100.0, freqs, n_cycles=[3, 4, 5, 6])
    assert [len(w) for w in W] == @@mw_len@@
    assert close(W[0].real, @@mw0r@@)
    assert close(W[0].imag, @@mw0i@@)
    assert close(np.abs(morlet(100.0, 12.0, 5.0, sigma=8.0, zero_mean=True)), @@mw2@@)
    assert close(fwhm(freqs, 5.0), @@fwhm@@)


@test
def test_tfr_array_morlet():
    X = sig(4, 3, 200)
    freqs = np.array([6.0, 10.0, 15.0, 22.0])
    p = tfr_array_morlet(X, 100.0, freqs, n_cycles=4.0, output="power")
    assert close(p[:, :, :, ::7], @@am_p@@)
    c = tfr_array_morlet(X, 100.0, freqs, n_cycles=np.array([3.0, 4, 5, 6]), output="complex", decim=3)
    assert close(c.real[:, :, :, ::5], @@am_cr@@, 1e-8)
    assert close(c.imag[:, :, :, ::5], @@am_ci@@, 1e-8)
    ph = tfr_array_morlet(X, 100.0, freqs, n_cycles=4.0, output="phase", use_fft=False)
    assert close(ph[:, :, :, ::9], @@am_ph@@, 1e-8)
    assert close(tfr_array_morlet(X, 100.0, freqs, n_cycles=4.0, output="avg_power", zero_mean=False)[:, :, ::6], @@am_ap@@)
    assert close(tfr_array_morlet(X, 100.0, freqs, n_cycles=4.0, output="itc")[:, :, ::6], @@am_itc@@)
    api = tfr_array_morlet(X, 100.0, freqs, n_cycles=4.0, output="avg_power_itc", decim=2)
    assert close(api.real[:, :, ::4], @@am_apir@@)
    assert close(api.imag[:, :, ::4], @@am_apii@@)


