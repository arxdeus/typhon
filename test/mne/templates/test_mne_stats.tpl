import numpy as np
import mne
import mne.stats as S
from scipy import sparse


def data(n: int, m: int, k: float = 0.0, off: float = 0.0):
    out = np.empty((n, m))
    for i in range(n):
        for j in range(m):
            out[i, j] = np.sin(0.7 * i * (j + 1) + 0.3 * j + k) + 0.4 * np.cos(1.9 * i + 0.5 * j * j + k) + off
    return out


def close(a, b, rtol: float = 1e-9, atol: float = 0.0) -> bool:
    x = np.asarray(a, dtype=float).ravel()
    z = np.asarray(b, dtype=float).ravel()
    if x.shape[0] != z.shape[0]:
        print("length mismatch", x.shape[0], z.shape[0])
        return False
    scale = float(np.max(np.abs(z))) if z.shape[0] > 0 else 0.0
    for i in range(x.shape[0]):
        if np.isinf(z[i]) and x[i] == z[i]:
            continue
        if abs(x[i] - z[i]) > atol + rtol * max(abs(z[i]), 1e-3 * scale):
            print("mismatch at", i, x[i], z[i])
            return False
    return True


def ieq(a, b: List[int]) -> bool:
    x = [int(v) for v in np.asarray(a).ravel()]
    if x != b:
        print("int mismatch", x, b)
        return False
    return True


def cflat(c) -> List[int]:
    out = List[int]()
    for arr in c:
        for v in arr:
            out.append(int(v))
    return out


@test
def test_parametric():
    X1 = data(12, 30, off=0.35)
    assert close(S.ttest_1samp_no_p(X1), @@tt1@@)
    assert close(S.ttest_1samp_no_p(X1, sigma=1e-3), @@tt1s@@)
    assert close(S.ttest_1samp_no_p(X1, sigma=0.1, method="absolute"), @@tt1a@@)
    A = data(10, 20, 0.0, 0.3)
    B = data(14, 20, 1.0)
    C3 = data(9, 20, 2.0, -0.2)
    assert close(S.ttest_ind_no_p(A, B), @@tti@@)
    assert close(S.ttest_ind_no_p(A, B, equal_var=False, sigma=0.01), @@ttiu@@)
    assert close(S.f_oneway(A, B, C3), @@f1@@)
    assert close(S.f_oneway(A, B, C3, sigma=0.1), @@f1s@@)


@test
def test_multi_comp():
    p = np.abs(np.sin(np.arange(25) * 1.7)) * 0.08
    r, pc = S.fdr_correction(p)
    assert ieq(r, @@fdr_r@@)
    assert close(pc, @@fdr_p@@)
    r, pc = S.fdr_correction(p, 0.1, "negcorr")
    assert ieq(r, @@fdrn_r@@)
    assert close(pc, @@fdrn_p@@)
    r, pc = S.bonferroni_correction(p * 0.05)
    assert ieq(r, @@bon_r@@)
    assert close(pc, @@bon_p@@)


@test
def test_anova_rm():
    D = np.empty((8, 6, 5))
    for k in range(6):
        D[:, k, :] = data(8, 5, float(k), 0.1 * k)
    f, pv = S.f_mway_rm(D, [2, 3])
    assert close(f, @@mw_f@@, 1e-8)
    assert close(pv, @@mw_p@@, 1e-7)
    f, pv = S.f_mway_rm(D, [2, 3], effects="A:B", correction=True)
    assert close(f, @@mwc_f@@, 1e-8)
    assert close(pv, @@mwc_p@@, 1e-7)
    assert close(np.array(S.f_threshold_mway_rm(8, [2, 3])), @@fth@@, 1e-8)
    assert close(np.array(S.f_threshold_mway_rm(8, [2, 3], effects="B", pvalue=0.01)), @@fth1@@, 1e-8)


