import numpy as np
from sklearn.linear_model import Ridge
from mne.decoding import ReceptiveField, TimeDelayingRidge


def stim(n_t: int, n_f: int):
    X = np.empty((n_t, n_f))
    for t in range(n_t):
        for f in range(n_f):
            X[t, f] = np.sin(0.37 * t * (f + 1) + f) + 0.5 * np.cos(0.11 * t + 2.0 * f)
    return X


def close(a, b, rtol: float = 1e-9, atol: float = 0.0) -> bool:
    x = np.asarray(a, dtype=float).ravel()
    z = np.asarray(b, dtype=float).ravel()
    if x.shape[0] != z.shape[0]:
        print("length mismatch", x.shape[0], z.shape[0])
        return False
    scale = float(np.max(np.abs(z))) if z.shape[0] > 0 else 0.0
    for i in range(x.shape[0]):
        if abs(x[i] - z[i]) > atol + rtol * max(abs(z[i]), 1e-6 * scale):
            print("mismatch at", i, x[i], z[i])
            return False
    return True


@test
def test_receptive_field():
    X = stim(200, 3)
    w = np.array([[0.5, -0.2, 0.1, 0.3], [0.0, 0.4, -0.3, 0.2], [0.1, 0.1, 0.2, -0.5]])
    y = np.zeros(200)
    for f in range(3):
        y += np.convolve(X[:, f].copy(), w[f].copy())[:200]
    for i in range(200):
        y[i] += 0.05 * np.sin(i * 1.3)
    rf = ReceptiveField(-0.01, 0.02, 100.0, estimator=1.0, patterns=True)
    rf.fit(X, y)
    assert close(rf.delays_, @@rf_delays@@)
    assert close(rf.coef_, @@rf_coef@@, 1e-8)
    assert close(rf.patterns_, @@rf_pat@@, 1e-8)
    assert close(rf.predict(X)[::17], @@rf_pred@@, 1e-8)
    assert close(rf.score(X, y), @@rf_score@@, 1e-8)
    rfc = ReceptiveField(0.0, 0.03, 100.0, estimator=0.5, scoring="corrcoef", fit_intercept=False)
    rfc.fit(X, y)
    assert close(rfc.coef_, @@rfc_coef@@, 1e-8)
    assert close(rfc.score(X, y), @@rfc_score@@, 1e-8)
    rfr = ReceptiveField(-0.02, 0.01, 100.0, estimator=Ridge(alpha=2.0), patterns=True)
    rfr.fit(X, y)
    assert close(rfr.coef_, @@rfr_coef@@, 1e-8)
    assert close(rfr.patterns_, @@rfr_pat@@, 1e-8)
    assert close(rfr.predict(X)[::19], @@rfr_pred@@, 1e-8)
    assert close(rfr.score(X, y), @@rfr_score@@, 1e-8)


@test
def test_time_delaying_ridge():
    X3 = np.empty((120, 3, 2))
    for e in range(3):
        X3[:, e, :] = stim(120, 2) * (1 + 0.1 * e)
    Y3 = np.empty((120, 3, 2))
    for t in range(120):
        for e in range(3):
            Y3[t, e, 0] = X3[t, e, 0] * 0.7 - 0.3 * X3[(t - 1) % 120, e, 1]
            Y3[t, e, 1] = X3[t, e, 1] * 0.2
    tdr = TimeDelayingRidge(0.0, 0.02, 100.0, alpha=3.0, reg_type="laplacian")
    tdr.fit(X3, Y3)
    assert close(tdr.coef_, @@tdr_coef@@, 1e-8)
    assert close(tdr.intercept_, @@tdr_int@@, 1e-8, 1e-12)
    assert close(tdr.predict(X3)[::13], @@tdr_pred@@, 1e-8)
    tdr2 = TimeDelayingRidge(-0.02, 0.01, 100.0, alpha=1.0, reg_type=("ridge", "laplacian"), fit_intercept=False)
    tdr2.fit(X3, Y3)
    assert close(tdr2.coef_, @@tdr2_coef@@, 1e-8)


test_receptive_field()
test_time_delaying_ridge()
