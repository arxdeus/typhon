# equalize_bads
mon = mne.channels.make_standard_montage('standard_1020')
ra = mne.io.RawArray(data, mne.create_info(names, sf, 'eeg'))
rb = mne.io.RawArray(mk(6, 800, 0.9) * 1e-5, mne.create_info(names, sf, 'eeg'))
ra.set_montage(mon)
rb.set_montage(mon)
ra.info['bads'] = ['Fz']
rb.info['bads'] = ['Fz', 'O1']
for th in [1.0, 0.0, 0.6]:
    o = mne.preprocessing.equalize_bads([ra, rb], interp_thresh=th)
    checks("eqb_bads_%d" % int(th * 10), o[0].info['bads'] + ['|'] + o[1].info['bads'])
    check("eqb_d0_%d" % int(th * 10), o[0].get_data()[:, 50:52], 1e-6, 1e-12)
    check("eqb_d1_%d" % int(th * 10), o[1].get_data()[:, 50:52], 1e-6, 1e-12)

# bridged electrodes
d3 = mk(6, 1500, 0.3) * 1e-5
d3[3] = d3[2] + 1e-8 * mk(1, 1500, 2.0)[0]
