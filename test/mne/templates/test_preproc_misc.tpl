def mk(nch: int, n: int, k: float):
    out = np.empty((nch, n))
    for i in range(nch):
        for j in range(n):
            out[i, j] = np.sin(0.05 * (i + 1) * j + k) + 0.3 * np.cos(0.31 * j * (i + 2) + 0.5 * i) + 0.2 * np.sin(2.0 * j)
    return out


names = ['Fp1', 'Fz', 'Cz', 'Pz', 'O1', 'O2']
sf = 100.0
data = mk(6, 1500, 0.3) * 1e-5
raw = mne.io.RawArray(data, mne.create_info(names, sf, 'eeg'))
ev = np.array([[100, 0, 1], [400, 0, 2], [700, 0, 1]])
for md in ['linear', 'window', 'constant']:
    r = raw.copy()
    mne.preprocessing.fix_stim_artifact(r, events=ev, event_id=1, tmin=-0.02, tmax=0.1, mode=md, baseline=(-0.1, -0.05))
    check("fsa_raw_" + md, r.get_data()[:, 95:115], 1e-9, 1e-15)
ep = mne.Epochs(raw, ev, tmin=-0.2, tmax=0.5, baseline=None, preload=True)
for md in ['linear', 'window', 'constant']:
    e2 = ep.copy()
    mne.preprocessing.fix_stim_artifact(e2, tmin=0.0, tmax=0.05, mode=md, baseline=(-0.1, -0.05))
    check("fsa_ep_" + md, e2.get_data()[1, :, 15:30], 1e-9, 1e-15)
evk = ep.average()
mne.preprocessing.fix_stim_artifact(evk, tmin=0.0, tmax=0.05)
check("fsa_evk", evk.data[:, 15:30], 1e-9, 1e-15)

