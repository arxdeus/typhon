def mk(nch: int, n: int, k: float):
    out = np.empty((nch, n))
    for i in range(nch):
        for j in range(n):
            out[i, j] = (np.sin(0.05 * (i + 1) * j + k) + 0.3 * np.cos(0.31 * j * (i + 2) + 0.5 * i)) * 1e-5
    return out


