import numpy as np
import mne
from mne.decoding import SSD


def close(a, b, rtol: float = 1e-9, atol: float = 0.0) -> bool:
    x = np.asarray(a, dtype=float).ravel()
    z = np.asarray(b, dtype=float).ravel()
    if x.shape[0] != z.shape[0]:
        print("length mismatch", x.shape[0], z.shape[0])
        return False
    scale = float(np.max(np.abs(z))) if z.shape[0] > 0 else 0.0
    for i in range(x.shape[0]):
        if abs(x[i] - z[i]) > atol + rtol * max(abs(z[i]), 1e-6 * scale):
            print("mismatch at", i, x[i], z[i])
            return False
    return True


@test
def test_ssd():
    n_t = 600
    Xs = np.empty((4, 5, n_t))
    for e in range(4):
        for c in range(5):
            for i in range(n_t):
                t = i / 200.0
                Xs[e, c, i] = (np.sin(2 * np.pi * 10.0 * t + 0.3 * e) * (1.0 if c in (1, 3) else 0.1)
                               + 0.6 * np.sin(2 * np.pi * (3.0 + c) * t + c)
                               + 0.4 * np.cos(2 * np.pi * (25.0 + 2 * c) * t + e)
                               + 0.2 * np.sin(0.9 * i * (c + 1) + e))
    info = mne.create_info(5, 200.0, "eeg")
    fs = {"l_freq": 9.0, "h_freq": 11.0, "l_trans_bandwidth": 1.0, "h_trans_bandwidth": 1.0}
    fn = {"l_freq": 7.0, "h_freq": 13.0, "l_trans_bandwidth": 1.0, "h_trans_bandwidth": 1.0}
    ssd = SSD(info, fs, fn)
    ssd.fit(Xs)
    src = ssd.transform(Xs)
    assert close(ssd.evals_, @@ssd_ev@@, 1e-7)
    assert close(np.abs(src[:2, :, ::41]), @@ssd_src@@, 1e-6, 1e-9)
    assert close(np.sort(np.abs(ssd.patterns_), axis=1), @@ssd_pat@@, 1e-6, 1e-9)
    assert close(ssd.get_spectral_ratio(src)[0], @@ssd_ratio@@, 1e-7)
    ssd2 = SSD(200.0, fs, fn, n_components=2, sort_by_spectral_ratio=False, reg=0.05, return_filtered=True)
    s2 = ssd2.fit_transform(Xs)
    assert close(ssd2.evals_, @@ssd2_ev@@, 1e-7)
    assert close(np.abs(s2[:2, :, ::41]), @@ssd2_src@@, 1e-6, 1e-9)
    assert close(ssd2.apply(Xs)[:1, :, ::53], @@ssd2_app@@, 1e-6, 1e-9)


test_ssd()
