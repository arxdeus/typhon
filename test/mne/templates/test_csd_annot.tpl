info = mne.create_info(NAMES, 100., 'eeg')
raw = mne.io.RawArray(data, info)
raw.set_montage('standard_1020')

# CSD with explicit sphere and default
c1 = mne.preprocessing.compute_current_source_density(raw, sphere=(0., 0., 0., 0.095))
check("csd_raw", c1.get_data()[:, 100:103], 1e-6, 1e-12)
checks("csd_type", c1.get_channel_types(unique=True))
