from mne.time_frequency import (EpochsTFRArray, csd_tfr, SpectrumArray, EpochsSpectrumArray, RawTFRArray,
                                combine_tfr, combine_spectrum, pick_channels_csd, AverageTFRArray, fit_iir_model_raw)
info = mne.create_info(['a', 'b', 'c'], 100., 'eeg')
rng = np.random.RandomState(0)
d = rng.randn(4, 3, 2, 10) + 1j * rng.randn(4, 3, 2, 10)
times = np.arange(10) / 100.
t = EpochsTFRArray(info, d, times, [8., 12.])
c = csd_tfr(t)
check("csd_data", c.get_data(index=0).real)
check("csd_data_im", c.get_data(index=1).imag)
check("csd_freqs", c.frequencies)
c2 = csd_tfr(t, tmin=0.02, tmax=0.06, picks=[0, 2])
checks("csd2_names", c2.ch_names)
check("csd2", c2.get_data(index=0).real)
check("csd2_im", c2.get_data(index=1).imag)
p = pick_channels_csd(c, include=['c', 'a'])
checks("pick_names", p.ch_names)
check("pick_data", p.get_data(index=0).real)
check("pick_im", p.get_data(index=1).imag)
p2 = pick_channels_csd(c, exclude=['b'])
check("pick2", p2.get_data(index=1).real)

sd = rng.rand(3, 5)
s = SpectrumArray(sd, info, np.arange(5.))
check("sa_data", s.get_data())
check("sa_freqs", s.freqs)
s2 = SpectrumArray(rng.rand(3, 5), info, np.arange(5.))
comb = combine_spectrum([s, s2], weights='equal')
check("cs_eq", comb.get_data())
comb = combine_spectrum([s, s2], weights=[2., -1.])
check("cs_w", comb.get_data())
ed = rng.rand(4, 3, 5)
es = EpochsSpectrumArray(ed, info, np.arange(5.))
check("esa_data", es.get_data())
check("esa_shape", es.get_data().shape)
r = RawTFRArray(info, rng.rand(3, 2, 10), times, [8., 12.])
check("rt_data", r.get_data())
check("rt_shape", r.get_data().shape)
a1 = AverageTFRArray(info, rng.rand(3, 2, 10), times, [8., 12.], nave=3)
a2 = AverageTFRArray(info, rng.rand(3, 2, 10), times, [8., 12.], nave=5)
cb = combine_tfr([a1, a2])
check("ct_data", cb.get_data())
check("ct_nave", [cb.nave])
cb = combine_tfr([a1, a2], weights='equal')
check("ct_eq", cb.get_data())
check("ct_eq_nave", [cb.nave])
cb = combine_tfr([a1, a2], weights=[1., -1.])
check("ct_sub", cb.get_data())

data = rng.randn(3, 400)
data[0] = np.cumsum(data[0]) * 0.1
raw = mne.io.RawArray(data * 1e-6, mne.create_info(['a', 'b', 'c'], 100., 'eeg'))
b, a = fit_iir_model_raw(raw, order=3)
check("iir_b", b)
check("iir_a", a, 1e-6)
b, a = fit_iir_model_raw(raw, order=2, picks=[0, 1], tmin=0.5, tmax=3.0)
check("iir_a2", a, 1e-6)
print("done")
