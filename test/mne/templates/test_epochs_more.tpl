def mk(nch: int, n: int, k: float):
    out = np.empty((nch, n))
    for i in range(nch):
        for j in range(n):
            out[i, j] = np.sin(0.05 * (i + 1) * j + k) + 0.3 * np.cos(0.31 * j * (i + 2) + 0.5 * i) + 0.2 * np.sin(2.0 * j)
    return out


names = ['Fp1', 'Fz', 'Cz', 'Pz', 'O1', 'O2']
sf = 100.0
data = mk(6, 1500, 0.3) * 1e-5
raw = mne.io.RawArray(data, mne.create_info(names, sf, 'eeg'))
ev = np.array([[100, 0, 1], [200, 0, 2], [300, 0, 1], [400, 0, 2], [500, 0, 1], [600, 0, 1], [700, 0, 2], [800, 0, 1], [900, 0, 1], [1000, 0, 1]])
ep = mne.Epochs(raw, ev, tmin=-0.2, tmax=0.5, baseline=None, preload=True)

# equalize_event_counts: truncate / mintime / random
e1 = ep.copy()
e1.equalize_event_counts(['1', '2'], method='truncate')
check("eq_trunc_n", [len(e1)])
check("eq_trunc_sel", e1.selection)
e2 = ep.copy()
e2.equalize_event_counts(['1', '2'], method='mintime')
check("eq_mint_sel", e2.selection)
e3 = ep.copy()
e3.equalize_event_counts(['1', '2'], method='random', random_state=5)
check("eq_rand_sel", e3.selection)

# drop_bad with reject_tmin/tmax
data2 = data.copy()
data2[1, 300 + 30] += 4e-4
raw2 = mne.io.RawArray(data2, mne.create_info(names, sf, 'eeg'))
ep2 = mne.Epochs(raw2, ev, tmin=-0.2, tmax=0.5, baseline=None, preload=True, reject_tmin=-0.1, reject_tmax=0.1)
ep2.drop_bad(reject={'eeg': 2e-4})
check("rej_win_sel", ep2.selection)
ep3 = mne.Epochs(raw2, ev, tmin=-0.2, tmax=0.5, baseline=None, preload=True, reject_tmin=0.2, reject_tmax=0.4)
ep3.drop_bad(reject={'eeg': 2e-4})
check("rej_win2_sel", ep3.selection)
ep4 = mne.Epochs(raw2, ev, tmin=-0.2, tmax=0.5, baseline=None, preload=True, reject={'eeg': 2e-4})
check("rej_direct_sel", ep4.selection)

# set_eeg_reference on epochs
e5 = ep.copy()
e5.set_eeg_reference('average')
check("ep_avgref", e5.get_data()[2, :, 5:7], 1e-9, 1e-15)
e6 = ep.copy()
e6.set_eeg_reference(['Cz', 'Pz'])
