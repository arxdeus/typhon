e8 = ep.copy()
e8.apply_function(lambda x: x - x.mean(axis=-1, keepdims=True), channel_wise=False)
check("ep_apply_all", e8.get_data()[3, :, 4:6], 1e-9, 1e-15)

# Evoked: detrend, apply_function, combine, grand_average
evk = ep['1'].average()
