def mk(nch: int, n: int, k: float):
    out = np.empty((nch, n))
    for i in range(nch):
        for j in range(n):
            out[i, j] = np.sin(0.05 * (i + 1) * j + k) + 0.3 * np.cos(0.31 * j * (i + 2) + 0.5 * i) + 0.2 * np.sin(2.0 * j)
    return out


names = ['Fp1', 'Fz', 'Cz', 'Pz', 'O1', 'O2', 'C3', 'C4']
sf = 100.0
data = mk(8, 1000, 0.3) * 1e-6
info = mne.create_info(names, sf, 'eeg')
raw = mne.io.RawArray(data, info)

# average reference projection
r1 = raw.copy()
r1.set_eeg_reference('average', projection=True)
check("avg_nproj", [len(r1.info['projs']), int(r1.info['projs'][0]['active'])])
check("avg_before", r1.get_data()[:, :4], 1e-9, 1e-15)
r1.apply_proj()
check("avg_after", r1.get_data()[:, :4], 1e-9, 1e-15)
check("avg_active", [int(r1.info['projs'][0]['active'])])

# SSP raw
projs = mne.compute_proj_raw(raw, duration=1.0, n_eeg=2)
check("ssp_n", [len(projs)])
checks("ssp_desc", [p['desc'] for p in projs])
check("ssp_var", [p['explained_var'] for p in projs], 1e-7, 1e-12)
r2 = raw.copy()
r2.add_proj(projs)
check("ssp_inactive", [int(r2.info['projs'][0]['active'])])
r2.apply_proj()
check("ssp_applied", r2.get_data()[:, 100:104], 1e-6, 1e-14)
projs2 = mne.compute_proj_raw(raw, duration=None, n_eeg=1, start=1.0, stop=5.0)
checks("ssp_nodur_desc", [p['desc'] for p in projs2])
check("ssp_nodur_var", [p['explained_var'] for p in projs2], 1e-7, 1e-12)
r2.del_proj(0) if False else None

# SSP epochs / evoked
ev = np.array([[100, 0, 1], [300, 0, 1], [500, 0, 2], [700, 0, 2]])
ep = mne.Epochs(raw, ev, tmin=-0.2, tmax=0.5, baseline=None, preload=True)
pe = mne.compute_proj_epochs(ep, n_eeg=3)
checks("pe_desc", [p['desc'] for p in pe])
check("pe_var", [p['explained_var'] for p in pe], 1e-7, 1e-12)
evk = ep.average()
pv = mne.compute_proj_evoked(evk, n_eeg=0.9)
checks("pv_desc", [p['desc'] for p in pv])
check("pv_var", [p['explained_var'] for p in pv], 1e-7, 1e-12)
ep2 = ep.copy()
ep2.add_proj(pe[:2])
ep2.apply_proj()
check("ep_applied", ep2.get_data()[1, :, 5:8], 1e-6, 1e-14)
ev2 = evk.copy()
ev2.add_proj(pv[:1])
ev2.apply_proj()
check("ev_applied", ev2.data[:, 10:13], 1e-6, 1e-14)

# Epochs from raw with proj
r3 = raw.copy()
